{
  "name": "yi-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false vite",
    "dev:test": "npm run db:migrate:local && CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false vite --host 127.0.0.1 --port 4173",
    "build": "npm run typecheck && CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false vite build",
    "build:preview": "npm run typecheck && CLOUDFLARE_ENV=preview CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false vite build --mode staging",
    "build:production": "npm run typecheck && CLOUDFLARE_ENV=production CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false vite build",
    "preview": "vite preview",
    "deploy": "npm run release:check && npm run build:production && wrangler deploy --config dist/yi_web/wrangler.json",
    "deploy:preview": "npm run build:preview && wrangler deploy --config dist/yi_web/wrangler.json",
    "typecheck": "tsc -p tsconfig.app.json --pretty false && tsc -p tsconfig.worker.json --pretty false && tsc -p tsconfig.node.json --pretty false",
    "test": "vitest run",
    "test:worker": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false vitest run --config vitest.worker.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:deepseek:live": "tsx scripts/smoke-deepseek.ts",
    "catalog:generate:takashima": "tsx scripts/generate-takashima-catalog.ts",
    "db:migrate:local": "wrangler d1 migrations apply yi-db-local --local",
    "db:migrate:preview": "wrangler d1 migrations apply yi-db-preview --remote --env preview",
    "db:migrate:production": "wrangler d1 migrations apply yi-db --remote --env production",
    "cf:typegen": "wrangler types worker-configuration.d.ts",
    "cf:typecheck": "wrangler types --check worker-configuration.d.ts",
    "release:catalog": "tsx scripts/validate-catalog.ts",
    "catalog:import:preview": "tsx scripts/import-catalog.ts --env preview",
    "catalog:import:production": "tsx scripts/import-catalog.ts --env production",
    "release:check": "tsx scripts/release-gate.ts",
    "check": "npm run typecheck && npm test && npm run test:worker && npm run build && npm run release:catalog"
  },
  "dependencies": {
    "better-auth": "1.6.26",
    "hono": "4.13.1",
    "i18next": "26.3.6",
    "openai": "7.4.0",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.11",
    "react-router-dom": "7.18.2",
    "stripe": "22.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.1",
    "@cloudflare/vitest-pool-workers": "0.20.3",
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "16.3.2",
    "@types/node": "latest",
    "@types/qrcode": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.0",
    "axe-core": "latest",
    "jsdom": "latest",
    "tsx": "latest",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.0",
    "wrangler": "4.120.0"
  }
}
