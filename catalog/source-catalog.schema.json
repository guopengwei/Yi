{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yi.rich-tide.com/schemas/source-catalog-v1.json",
  "title": "Yi rights-cleared trilingual source catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseId", "entries"],
  "properties": {
    "schemaVersion": { "const": "yi-source-catalog@1" },
    "releaseId": { "type": "string", "format": "uuid" },
    "entries": {
      "type": "array",
      "minItems": 1350,
      "maxItems": 1350,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "entryKey", "entryType", "locale", "text", "provenance", "rightsStatus", "approvalStatus"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "entryKey": { "type": "string", "minLength": 1, "maxLength": 200 },
          "entryType": { "enum": ["hexagram", "line", "special-line"] },
          "locale": { "enum": ["zh-HK", "zh-CN", "en"] },
          "text": { "type": "string", "minLength": 1, "maxLength": 8000 },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "locator"],
            "properties": {
              "title": { "type": "string", "minLength": 1, "maxLength": 500 },
              "creator": { "type": "string", "maxLength": 300 },
              "publication": { "type": "string", "maxLength": 500 },
              "locator": { "type": "string", "minLength": 1, "maxLength": 500 },
              "sourceUrl": { "type": "string", "format": "uri", "maxLength": 2000 }
            }
          },
          "rightsStatus": { "enum": ["public-domain-mark", "permission", "commissioned"] },
          "approvalStatus": { "const": "approved" }
        }
      }
    }
  }
}
